[Unit]
Description=Lampa Local
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lampa
Group=lampa
WorkingDirectory=/opt/lampa-local
EnvironmentFile=/etc/lampa-local.env
ExecStart=/usr/bin/python3 /opt/lampa-local/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
